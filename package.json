{
  "name": "purpo",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@google/genai": "^1.20.0",
    "@prisma/client": "6.19.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.5",
    "clsx": "^2.1.1",
    "ioredis": "^5.7.0",
    "jose": "^6.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.542.0",
    "nanoid": "^5.1.5",
    "next": "16.3.5",
    "openai": "^5.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "^1.17.0",
    "stripe": "^18.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ssh2": "^1.15.5",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.19.0"
}
